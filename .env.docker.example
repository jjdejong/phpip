APP_NAME=phpIP
COMPANY_NAME="My Company"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
APP_LOCALE=en_US
APP_TIMEZONE=America/Chicago
# Optional comma-separated IPs/CIDRs of TLS-terminating reverse proxies.
TRUSTED_PROXIES=

DB_DATABASE=phpip
DB_USERNAME=phpip
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Log mail locally until SMTP and recipients are configured.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=phpIP
MAIL_TO=

# Configure integrations before enabling the scheduler profile.
OPS_APP_KEY=
OPS_SECRET=
RENEWR_API_URL=https://demo-api.renewr.io/api/external/patent/with-renewal-event-and-fees
RENEWR_API_KEY=
SHAREPOINT_ENABLED=false
